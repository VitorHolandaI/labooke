# Docker host ports
FRONTEND_PORT=8080
API_PORT=8010

# Backend runtime
LABOOKE_API_HOST=127.0.0.1
LABOOKE_API_PORT=8000
LABOOKE_API_RELOAD=true
LABOOKE_CORS_ORIGINS=http://localhost:5173

# Local data paths
LABOOKE_DATA_DIR=./data
LABOOKE_IMPORT_DIR=./data/inbox

# Embeddings
LABOOKE_EMBED_MODEL=intfloat/multilingual-e5-small
LABOOKE_EMBED_CACHE_MODEL=true
LABOOKE_EMBED_WORKER_IDLE_SECONDS=60
LABOOKE_CHUNK_PAGES=1

# LLM (Ollama, OpenAI-compatible). Leave base_url/model empty to disable.
# Ollama runs locally with no API key: point base_url at /v1 and set any key.
LABOOKE_LLM_BASE_URL=http://10.66.66.15:11434/v1
LABOOKE_LLM_MODEL=qwen2.5:7b
LABOOKE_LLM_API_KEY=ollama
LABOOKE_LLM_SUMMARY_PAGES=10
LABOOKE_LLM_RAG_K=10
LABOOKE_LLM_AUTO_SUMMARIZE=false

# CLI client
LABOOKE_API_URL=http://localhost:8000
