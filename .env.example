# Docker host ports
FRONTEND_PORT=8080
API_PORT=8010

# Backend runtime
LABOOKE_API_HOST=127.0.0.1
LABOOKE_API_PORT=8000
LABOOKE_API_RELOAD=true
LABOOKE_CORS_ORIGINS=http://localhost:5173

# Local data paths
LABOOKE_DATA_DIR=./data
LABOOKE_IMPORT_DIR=./data/inbox

# Embeddings
LABOOKE_EMBED_MODEL=intfloat/multilingual-e5-small
LABOOKE_EMBED_CACHE_MODEL=true
LABOOKE_EMBED_WORKER_IDLE_SECONDS=60
LABOOKE_CHUNK_PAGES=1

# CLI client
LABOOKE_API_URL=http://localhost:8000
